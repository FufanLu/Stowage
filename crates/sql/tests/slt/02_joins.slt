statement ok
INSERT INTO orders VALUES (10, 1, 99.5, 'paid'), (11, 1, 20, 'open'), (12, 2, 5.25, 'paid'), (13, 9, 1, 'paid')

query TR rowsort
SELECT c.name, o.amount FROM customers c JOIN orders o ON o.customer_id = c.id
----
acme 20
acme 99.5
globex 5.25

query TI rowsort
SELECT c.name, o.id FROM customers c LEFT JOIN orders o ON o.customer_id = c.id AND o.status = 'paid'
----
acme 10
globex 12
initech NULL

query TR
SELECT c.name, sum(o.amount) AS total FROM customers c JOIN orders o ON c.id = o.customer_id GROUP BY c.name ORDER BY total DESC
----
acme 119.5
globex 5.25

query TI
SELECT c.country, count(*) FROM customers c, orders o WHERE c.id = o.customer_id AND o.status = 'paid' GROUP BY c.country ORDER BY 1
----
de 1
us 1

query I
SELECT count(*) FROM customers c CROSS JOIN orders o
----
12

query T
SELECT name FROM customers WHERE id IN (SELECT customer_id FROM orders WHERE amount > 10) ORDER BY name
----
acme

query T
SELECT name FROM customers WHERE id NOT IN (SELECT customer_id FROM orders) ORDER BY name
----
initech

query R
SELECT (SELECT max(amount) FROM orders)
----
99.5

