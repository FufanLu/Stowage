CREATE TABLE regions (country TEXT PRIMARY KEY, region TEXT)

statement ok
INSERT INTO regions VALUES ('us', 'americas'), ('de', 'emea')

query TTR rowsort
SELECT r.region, c.name, o.amount FROM orders o JOIN customers c ON o.customer_id = c.id JOIN regions r ON r.country = c.country WHERE o.status = 'paid'
----
americas acme 99.5
emea globex 5.25

query TI rowsort
SELECT x.name, x.n FROM (SELECT c.name, count(o.id) AS n FROM customers c LEFT JOIN orders o ON o.customer_id = c.id GROUP BY c.name) AS x
----
acme 2
globex 1
initech 0
